{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rssig CLI fixture testcases, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixtures",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "fixtures": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "command",
          "expect"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "expect": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "exit_code",
              "json"
            ],
            "properties": {
              "exit_code": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "json": {},
              "contains": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "not": {
          "required": [
            "input",
            "inputs"
          ]
        }
      }
    }
  }
}
